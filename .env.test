# Environment defaults for the "test" environment (safe dummy values).
# Real values live in uncommitted .env.test.local or real environment variables.

###> symfony/framework-bundle ###
APP_SECRET=not-so-secret-test-value
KERNEL_CLASS='App\Kernel'
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Kernel boot does not connect to the database, dummy DSNs are enough.
APP_DATABASE_URL=postgres://app:password@127.0.0.1:5432/app_test
MAGNETICOD_DATABASE_URL=postgres://app:password@127.0.0.1:5432/magneticod_test
###< doctrine/doctrine-bundle ###

REDIS_DSN=redis://127.0.0.1:6379/1

MAILER_DSN=null://null
MAILER_FROM=test@example.tld

TRUSTED_PROXIES=127.0.0.1

###> karser/karser-recaptcha3-bundle ###
# Captcha is disabled in test env via config, dummy values keep env resolution happy.
RECAPTCHA3_KEY=test-site-key
RECAPTCHA3_SECRET=test-secret
###< karser/karser-recaptcha3-bundle ###
